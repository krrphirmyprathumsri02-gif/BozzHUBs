GetLastName = function()
	for i,v in next, getgc(true) do
		if typeof(v) == "table" and rawget(v, "PlayerData") then
			for _,v in pairs(v.PlayerData) do
				if _ == "LastName" then
					return v
				end
			end
		end
	end
end

GetChance = function()
	for i,v in next, getgc(true) do
		if typeof(v) == "table" and rawget(v, "PlayerData") then
			for _,v in pairs(v.PlayerData) do
				if _ == "FamilyRolls" then
					return v
				end
			end
		end
	end
end

getgenv().AutoReroll = {
    ["Enable"] = true,
    ["TargetRoll"] = "Kamado"
}



 task.spawn(function()
        while task.wait(0.01) do
            local Lastname = GetLastName()
            local Chance = GetChance()
            local targetRoll = getgenv().AutoReroll["TargetRoll"]
            if getgenv().AutoReroll["Enable"] then
                if Lastname == targetRoll then
                    RM_Sync:InvokeServer("Character","Customization","Eyes",1)
                elseif Chance > 0 then
                    RM_Sync:InvokeServer(unpack(RollbackArgs))
                    task.wait(0.1)
                    RM_Sync:InvokeServer(unpack(RerollArgs))
                    task.wait(0.1)
                else 
                    Rejoid()
                    break
                end
            end
        end
    end)





